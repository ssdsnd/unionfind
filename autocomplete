import com.sun.net.httpserver.HttpServer;
import com.sun.net.httpserver.HttpExchange;

import java.io.*;
import java.net.InetSocketAddress;
import java.net.URI;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.*;

public class EmployeeApi {

    static class Employee {
        String id;
        String name;

        Employee(String id, String name) {
            this.id = id;
            this.name = name;
        }
    }

    static final List<Employee> employees = new ArrayList<>();

    public static void main(String[] args) throws Exception {

        loadCsv("employees.csv");

        employees.sort(Comparator.comparing(e -> e.id));

        HttpServer server = HttpServer.create(new InetSocketAddress(8080), 0);

        server.createContext("/autocomplete", EmployeeApi::handleAutocomplete);

        server.start();

        System.out.println("Server running at http://localhost:8080");
    }

    // ---------------- CSV LOADER ----------------
    static void loadCsv(String filePath) throws IOException {

        try (BufferedReader br = Files.newBufferedReader(Paths.get(filePath))) {

            String line;

            while ((line = br.readLine()) != null) {

                line = line.trim();
                if (line.isEmpty()) continue;

                String[] parts = line.split(",", 2);

                if (parts.length < 2) continue;

                String id = parts[0].trim();
                String name = parts[1].trim();

                employees.add(new Employee(id, name));
            }
        }

        System.out.println("Loaded employees: " + employees.size());
    }

    // ---------------- HTTP HANDLER ----------------
    static void handleAutocomplete(HttpExchange exchange) throws IOException {

        URI uri = exchange.getRequestURI();

        String query = uri.getQuery();
        String prefix = "";

        if (query != null && query.startsWith("q=")) {
            prefix = query.substring(2);
        }

        List<Employee> result = search(prefix, 10);

        String json = toJson(result);

        exchange.getResponseHeaders()
                .add("Content-Type", "application/json");

        byte[] bytes = json.getBytes(StandardCharsets.UTF_8);

        exchange.sendResponseHeaders(200, bytes.length);

        try (OutputStream os = exchange.getResponseBody()) {
            os.write(bytes);
        }
    }

    // ---------------- AUTOCOMPLETE SEARCH ----------------
    static List<Employee> search(String prefix, int limit) {

        int start = bisectLeft(prefix);

        List<Employee> result = new ArrayList<>();

        for (int i = start; i < employees.size(); i++) {

            Employee e = employees.get(i);

            if (!e.id.startsWith(prefix)) {
                break;
            }

            result.add(e);

            if (result.size() >= limit) break;
        }

        return result;
    }

    // ---------------- BINARY SEARCH ----------------
    static int bisectLeft(String target) {

        int low = 0;
        int high = employees.size();

        while (low < high) {

            int mid = (low + high) >>> 1;

            if (employees.get(mid).id.compareTo(target) < 0) {
                low = mid + 1;
            } else {
                high = mid;
            }
        }

        return low;
    }

    // ---------------- JSON RESPONSE ----------------
    static String toJson(List<Employee> list) {

        StringBuilder sb = new StringBuilder();
        sb.append("[");

        for (int i = 0; i < list.size(); i++) {

            Employee e = list.get(i);

            if (i > 0) sb.append(",");

            sb.append("{")
              .append("\"id\":\"").append(e.id).append("\",")
              .append("\"name\":\"").append(e.name).append("\"")
              .append("}");
        }

        sb.append("]");
        return sb.toString();
    }
}

